# Normalise line endings: LF in the repository, native on checkout
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfiles: treat as generated (collapsed in diffs, excluded from language stats)
pnpm-lock.yaml linguist-generated=true -diff
package-lock.json linguist-generated=true -diff

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.mp4 binary
*.pt binary
*.onnx binary
*.zip binary
