# ==============================================================================
#  DrishtiGuard — root .gitignore
#  Covers: front end/ (Node/Vite), backend/ (FastAPI), ai_models/, ml/ (YOLO)
#  Rule of thumb: commit source, configs, docs and *.example files;
#  never commit secrets, dependencies, datasets, weights, runs or user uploads.
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & local environment
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!**/.env.example
*.pem
*.key
secrets.json
credentials.json

# ------------------------------------------------------------------------------
# Node / frontend
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
vite.config.*.timestamp-*

# Build output
dist/
dist-ssr/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
build/

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.venv/
venv/
/env/
ENV/
.python-version
pip-log.txt

# Tooling caches / test output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
coverage/
htmlcov/
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# ML — datasets & prepared data (downloaded / generated, can be many GB)
# ------------------------------------------------------------------------------
**/datasets/
**/prepared/
*.cache
labels.cache
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ------------------------------------------------------------------------------
# ML — model weights & exports
#   Base weights (yolo11n.pt, yolov8s-worldv2.pt …) are auto-downloaded by
#   Ultralytics; trained weights are produced by ml/ and ai_models/ pipelines.
# ------------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.torchscript
*.engine
*.tflite
*.pb
*.h5
*.keras
*.weights
*.bin
*.pkl
*.pickle
*.joblib
**/weights/
**/exports/
ml/models/

# ------------------------------------------------------------------------------
# ML — training runs, experiment trackers, checkpoints
# ------------------------------------------------------------------------------
runs/
**/runs/
wandb/
mlruns/
lightning_logs/
ai_models/checkpoints/*
!ai_models/checkpoints/README.md

# ------------------------------------------------------------------------------
# Application data (user uploads, generated reports, local DB store)
# ------------------------------------------------------------------------------
backend/data/
uploads/*
!uploads/.gitkeep
reports/*
!reports/.gitkeep
ml/reports/*
!ml/reports/.gitkeep

# Media files produced at runtime (screenshots under docs/ are kept)
*.mp4
*.avi
*.mov
*.mkv
*.webm

# ------------------------------------------------------------------------------
# Logs & temp files
# ------------------------------------------------------------------------------
*.log
logs/
*.bak
*.tmp
*.temp
*.swp
*.sw?

# ------------------------------------------------------------------------------
# OS files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# IDE / editor
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# AI assistant local state (keep shared project config, drop personal state)
# ------------------------------------------------------------------------------
.claude/settings.local.json
.gemini/
.cursor/
.system_generated/
